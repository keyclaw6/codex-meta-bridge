[Unit]
Description=Codex Meta Bridge
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
UMask=0077
Environment=HOME=/root
Environment=CODEX_HOME=/var/lib/codex-root
WorkingDirectory=/home/vpsdesktop/codex-meta-bridge
ExecStart=/usr/bin/node /home/vpsdesktop/codex-meta-bridge/src/daemon.mjs
Restart=always
RestartSec=3
StandardOutput=append:/home/vpsdesktop/codex-meta-bridge/bridge/logs/daemon.log
StandardError=append:/home/vpsdesktop/codex-meta-bridge/bridge/logs/daemon.log

[Install]
WantedBy=multi-user.target
